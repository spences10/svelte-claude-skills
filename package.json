{
	"name": "svelte-claude-skills",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "vp fmt --write .",
		"lint": "vp check",
		"test:unit": "vp test",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"prep:test-bed": "rm -rf test-bed && pnpx sv create test-bed --template minimal && cp -r .claude test-bed/"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.2.76"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-auto": "8.0.1",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.1",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "5.1.0",
		"better-sqlite3": "^12.8.0",
		"daisyui": "^5.5.19",
		"mdsvex": "^0.12.7",
		"playwright": "^1.58.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.2.1",
		"typescript": "6.0.3",
		"valibot": "^1.2.0",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
		"vite-plus": "1.6.0",
		"vitest": "5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	}
}
